{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EchoHub",
  "version": "0.1.0",
  "identifier": "agency.echo.echohub",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:37822",
    "beforeDevCommand": "VITE_MSW=false bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "EchoHub",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:*; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libssl3",
          "libayatana-appindicator3-1"
        ]
      }
    },
    "category": "Utility",
    "shortDescription": "Local AI interface \u2014 run LLMs on your GPU, no cloud"
  }
}